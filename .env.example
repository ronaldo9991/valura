# Server
NODE_ENV=production
PORT=8080
PUBLIC_URL=https://your-domain.up.railway.app
LOG_LEVEL=info

# Database (Railway-managed Postgres add-on injects this automatically)
DATABASE_URL=postgres://user:pass@host:5432/dbname

# AI
OPENAI_API_KEY=sk-...

# Auth (Clerk) - required once Phase B.1 is implemented
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# CLERK_WEBHOOK_SECRET=whsec_...

# Frontend (must be set at BUILD TIME, baked into Vite bundle)
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# VITE_SENTRY_DSN=https://...@sentry.io/...

# Observability (optional)
# SENTRY_DSN=https://...@sentry.io/...

# News (Finnhub free tier)
# FINNHUB_API_KEY=...

# Email (Resend, for price alerts)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=alerts@your-domain.com
